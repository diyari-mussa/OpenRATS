<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>BTMob</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net462</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup />
  <ItemGroup>
    <!-- Standalone harnesses; keep them out of the app build. -->
    <Compile Remove="TestLocalBuilder\**" />
    <None Remove="TestLocalBuilder\**" />
    <EmbeddedResource Remove="TestLocalBuilder\**" />
    <Compile Remove="ReadEntryPoint\**" />
    <None Remove="ReadEntryPoint\**" />
    <EmbeddedResource Remove="ReadEntryPoint\**" />
    <Compile Remove="DumpPatchedIl\**" />
    <None Remove="DumpPatchedIl\**" />
    <EmbeddedResource Remove="DumpPatchedIl\**" />
    <Compile Remove="AnalyzeClrDump\**" />
    <None Remove="AnalyzeClrDump\**" />
    <EmbeddedResource Remove="AnalyzeClrDump\**" />
    <Compile Remove="JitIlDump\**" />
    <None Remove="JitIlDump\**" />
    <EmbeddedResource Remove="JitIlDump\**" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="DrakeUI.Framework">
      <HintPath>libs\DrakeUI.Framework.dll</HintPath>
    </Reference>
    <Reference Include="System.ValueTuple">
      <HintPath>libs\System.ValueTuple.dll</HintPath>
    </Reference>
    <Reference Include="System.Net.Http" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>libs\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="ObjectListView">
      <HintPath>libs\ObjectListView.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms">
      <HintPath>libs\Microsoft.Web.WebView2.WinForms.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>libs\Microsoft.Web.WebView2.Core.dll</HintPath>
    </Reference>
    <Reference Include="System.Xml" />
    <Reference Include="FastColoredTextBox">
      <HintPath>libs\FastColoredTextBox.dll</HintPath>
    </Reference>
    <Reference Include="WebSocket4Net">
      <HintPath>libs\WebSocket4Net.dll</HintPath>
    </Reference>
    <Reference Include="SuperSocket.ClientEngine">
      <HintPath>libs\SuperSocket.ClientEngine.dll</HintPath>
    </Reference>
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Core" />
    <Reference Include="System.Web" />
    <Reference Include="BouncyCastle.Cryptography">
      <HintPath>libs\BouncyCastle.Cryptography.dll</HintPath>
    </Reference>
    <Reference Include="ObjectListView.IO">
      <HintPath>libs\ObjectListView.IO.dll</HintPath>
    </Reference>
    <Reference Include="System.Management" />
    <Reference Include="Magick.NET-Q8-AnyCPU">
      <HintPath>libs\Magick.NET-Q8-AnyCPU.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>